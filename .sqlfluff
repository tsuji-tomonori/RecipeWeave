[sqlfluff]
dialect = postgres
templater = placeholder
max_line_length = 100
large_file_skip_byte_limit = 0
disable_noqa = True

# 実行値は渡さず、psycopgの名前付き引数を検査用の値で解析する。
[sqlfluff:templater:placeholder]
param_style = pyformat
subject = 'verified-subject'
payload = '{}'
revision = 1
end = 120
start = 0
index = 0
offset = 0
actor_id = '00000000-0000-0000-0000-000000000001'
reference_id = '00000000-0000-0000-0000-000000000001'
after_id = '00000000-0000-0000-0000-000000000001'

q = ''
preview = FALSE
recipe_id = '00000000-0000-0000-0000-000000000001'
exclude_id = '00000000-0000-0000-0000-000000000002'
max_minutes = 30
selected_food_ids = '{}'
excluded_food_ids = '{}'
equipment = '{}'
match = 'all'
limit = 50
user_id = '00000000-0000-0000-0000-000000000001'
row_id = '00000000-0000-0000-0000-000000000001'
name = 'フライパン'
owner_id = '00000000-0000-0000-0000-000000000001'
version_id = '00000000-0000-0000-0000-000000000001'

# 束縛値を列名と誤認しないよう、全パラメータに固定の検査用リテラルを与える。
action = 'sample'
active = 'sample'
actual_end_at = 'sample'
actual_start_at = 'sample'
after_step_id = '00000000-0000-0000-0000-000000000001'
after_task_id = '00000000-0000-0000-0000-000000000001'
algorithm_version = 'sample'
alias = 'sample'
allergen_id = '00000000-0000-0000-0000-000000000001'
allowed = 'sample'
allowed_values = 'sample'
amount = 1
amount_max = 'sample'
amount_mode = 'sample'
archived = TRUE
attempt_count = 'sample'
attempted = 'sample'
attempts = 'sample'
attention = 'sample'
axis_id = '00000000-0000-0000-0000-000000000001'
