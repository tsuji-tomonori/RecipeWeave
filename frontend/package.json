{
  "name": "@recipeweave/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/prepare-ocr.mjs && node ../tools/build-service-docs.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:quality": "playwright test --config quality.config.ts"
  },
  "dependencies": {
    "@tesseract.js-data/jpn": "1.0.0",
    "lucide-svelte": "1.0.1",
    "svelte": "5.57.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
