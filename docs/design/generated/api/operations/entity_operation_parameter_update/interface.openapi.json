            "description": "許容下限",
            "title": "Min Value"
          },
          "name": {
            "description": "厚さ等",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "operation_id": {
            "description": "動作",
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
