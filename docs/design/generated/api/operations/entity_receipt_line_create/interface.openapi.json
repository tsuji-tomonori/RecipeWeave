                "$ref": "#/components/schemas/ReceiptLineWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptLineRow"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "認証が必要"
          },
          "403": {
            "description": "操作・参照権限なし"
          },
          "409": {
            "description": "同時更新またはDB業務制約違反"
          },
          "422": {
            "description": "入力不正"
          },
          "503": {
            "description": "DB接続不可"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "レシートの商品候補と確定した在庫の対応の作成",
        "tags": [
