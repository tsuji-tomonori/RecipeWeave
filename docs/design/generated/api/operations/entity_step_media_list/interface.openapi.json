{
  "components": {
    "schemas": {
      "StepMediaRow": {
        "additionalProperties": false,
        "description": "工程別メディア選択のDB応答。",
        "properties": {
          "created_at": {
            "description": "作成日時(UTC)",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "end_ms": {
            "description": "終了点",
            "title": "End Ms",
            "type": "integer"
          },
          "etag": {
            "description": "更新・削除時のIf-Matchに使う行版",
            "pattern": "^[0-9]+$",
            "title": "Etag",
            "type": "string"
          },
          "id": {
            "description": "不変の行識別子",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "media_id": {
            "description": "適用メディア",
            "format": "uuid",
            "title": "Media Id",
            "type": "string"
          },
          "start_ms": {
            "description": "表示開始点",
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "integer"
          },
          "step_id": {
            "description": "対象工程",
            "format": "uuid",
            "title": "Step Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "step_id",
          "media_id",
          "start_ms",
          "end_ms",
          "etag"
        ],
        "title": "StepMediaRow",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "食品・料理・工程・利用者操作を正規化したPostgreSQLから提供するAPI。",
    "title": "RecipeWeave API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/entities/step_media": {
      "get": {
        "description": "工程別メディア選択の一覧。認証情報は依存から取得し、本人所有または管理者権限を検査する。",
        "operationId": "entity_step_media_list",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StepMediaRow"
                  },
                  "title": "Response Entity Step Media List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "認証が必要"
          },
          "403": {
            "description": "操作・参照権限なし"
          },
          "409": {
            "description": "同時更新またはDB業務制約違反"
          },
          "422": {
            "description": "入力不正"
          },
          "503": {
            "description": "DB接続不可"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "工程別メディア選択の一覧",
        "tags": [
          "正規化データ: 工程別メディア選択"
        ]
      }
    }
  }
}
