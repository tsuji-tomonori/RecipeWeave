{
  "components": {
    "schemas": {
      "RecipeRow": {
        "additionalProperties": false,
        "description": "レシピ同一性のDB応答。",
        "properties": {
          "created_at": {
            "description": "作成日時(UTC)",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "etag": {
            "description": "更新・削除時のIf-Matchに使う行版",
            "pattern": "^[0-9]+$",
            "title": "Etag",
            "type": "string"
          },
          "family_option_id": {
            "description": "料理ファミリ",
            "format": "uuid",
            "title": "Family Option Id",
            "type": "string"
          },
          "id": {
            "description": "不変の行識別子",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "description": "公開状態",
            "enum": [
              "draft",
              "published",
              "withdrawn"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "description": "代表名",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "withdrawal_reason": {
            "anyOf": [
              {
                "maxLength": 20000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "取下げ理由",
            "title": "Withdrawal Reason"
          }
        },
        "required": [
          "id",
          "created_at",
          "title",
          "family_option_id",
          "status",
          "withdrawal_reason",
          "etag"
        ],
        "title": "RecipeRow",
        "type": "object"
      },
      "RecipeWrite": {
        "additionalProperties": false,
        "description": "レシピ同一性の編集可能列。未指定NULL列はNULLにする。",
        "properties": {
          "family_option_id": {
            "description": "料理ファミリ",
            "format": "uuid",
            "title": "Family Option Id",
            "type": "string"
          },
          "status": {
            "description": "公開状態",
            "enum": [
              "draft",
              "published",
              "withdrawn"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "description": "代表名",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "withdrawal_reason": {
            "anyOf": [
              {
                "maxLength": 20000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "取下げ理由",
            "title": "Withdrawal Reason"
          }
        },
        "required": [
          "title",
          "family_option_id",
          "status"
        ],
        "title": "RecipeWrite",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "食品・料理・工程・利用者操作を正規化したPostgreSQLから提供するAPI。",
    "title": "RecipeWeave API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/entities/recipe": {
      "post": {
        "description": "レシピ同一性の作成。認証情報は依存から取得し、本人所有または管理者権限を検査する。",
        "operationId": "entity_recipe_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRow"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "認証が必要"
          },
          "403": {
            "description": "操作・参照権限なし"
          },
          "409": {
            "description": "同時更新またはDB業務制約違反"
          },
          "422": {
            "description": "入力不正"
          },
          "503": {
            "description": "DB接続不可"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "レシピ同一性の作成",
        "tags": [
          "正規化データ: レシピ同一性"
        ]
      }
    }
  }
}
