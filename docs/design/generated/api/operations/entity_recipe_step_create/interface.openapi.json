  "info": {
    "description": "食品・料理・工程・利用者操作を正規化したPostgreSQLから提供するAPI。",
    "title": "RecipeWeave API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/entities/recipe_step": {
      "post": {
        "description": "調理工程節点の作成。認証情報は依存から取得し、本人所有または管理者権限を検査する。",
        "operationId": "entity_recipe_step_create",
        "parameters": [],
        "requestBody": {
          "content": {
