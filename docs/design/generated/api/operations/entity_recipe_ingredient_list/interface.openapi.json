            "title": "Scaling Rule Id",
            "type": "string"
          },
          "unit_id": {
            "description": "登録単位",
            "format": "uuid",
            "title": "Unit Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "recipe_version_id",
          "line_no",
          "form_id",
          "product_version_id",
          "component_id",
          "kit_parent_line_id",
          "role",
          "demand_kind",
          "amount_mode",
          "amount",
          "amount_max",
          "unit_id",
          "canonical_amount",
          "conversion_id",
          "scaling_rule_id",
          "optional",
          "note",
          "etag"
        ],
        "title": "RecipeIngredientRow",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "食品・料理・工程・利用者操作を正規化したPostgreSQLから提供するAPI。",
    "title": "RecipeWeave API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/entities/recipe_ingredient": {
      "get": {
