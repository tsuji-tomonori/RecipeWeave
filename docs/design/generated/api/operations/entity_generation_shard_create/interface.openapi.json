                "type": "null"
              }
            ],
            "description": "ワーカー識別子",
            "title": "Lease Owner"
          },
          "next_ordinal": {
            "description": "再開位置",
            "pattern": "^-?(0|[1-9][0-9]{0,18})$",
            "title": "Next Ordinal",
            "type": "string"
          },
          "start_ordinal": {
            "description": "開始序数",
            "pattern": "^-?(0|[1-9][0-9]{0,18})$",
            "title": "Start Ordinal",
            "type": "string"
          },
          "state": {
            "description": "待機/実行/完了/停止",
            "enum": [
              "queued",
