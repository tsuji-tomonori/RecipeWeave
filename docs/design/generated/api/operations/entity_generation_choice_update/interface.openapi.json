{
  "components": {
    "schemas": {
      "GenerationChoiceRow": {
        "additionalProperties": false,
        "description": "生成軸の選択値のDB応答。",
        "properties": {
          "created_at": {
            "description": "作成日時(UTC)",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "etag": {
            "description": "更新・削除時のIf-Matchに使う行版",
            "pattern": "^[0-9]+$",
            "title": "Etag",
            "type": "string"
          },
          "id": {
            "description": "不変の行識別子",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "job_id": {
            "description": "実行",
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "option_id": {
            "description": "選択した軸候補",
            "format": "uuid",
            "title": "Option Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "job_id",
          "option_id",
          "etag"
        ],
        "title": "GenerationChoiceRow",
        "type": "object"
      },
      "GenerationChoiceWrite": {
        "additionalProperties": false,
        "description": "生成軸の選択値の編集可能列。未指定NULL列はNULLにする。",
        "properties": {
          "job_id": {
            "description": "実行",
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "option_id": {
            "description": "選択した軸候補",
            "format": "uuid",
            "title": "Option Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "option_id"
        ],
        "title": "GenerationChoiceWrite",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "食品・料理・工程・利用者操作を正規化したPostgreSQLから提供するAPI。",
    "title": "RecipeWeave API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/entities/generation_choice/{row_id}": {
      "put": {
        "description": "生成軸の選択値の更新。認証情報は依存から取得し、本人所有または管理者権限を検査する。",
        "operationId": "entity_generation_choice_update",
        "parameters": [
          {
            "in": "path",
            "name": "row_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Row Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationChoiceWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationChoiceRow"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "認証が必要"
          },
          "403": {
            "description": "操作・参照権限なし"
          },
          "409": {
            "description": "同時更新またはDB業務制約違反"
          },
          "422": {
            "description": "入力不正"
          },
          "428": {
            "description": "If-Matchが必要"
          },
          "503": {
            "description": "DB接続不可"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "生成軸の選択値の更新",
        "tags": [
          "正規化データ: 生成軸の選択値"
        ]
      }
    }
  }
}
