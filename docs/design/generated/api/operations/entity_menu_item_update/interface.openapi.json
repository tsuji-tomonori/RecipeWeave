{
  "components": {
    "schemas": {
      "MenuItemRow": {
        "additionalProperties": false,
        "description": "献立の料理のDB応答。",
        "properties": {
          "created_at": {
            "description": "作成日時(UTC)",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "etag": {
            "description": "更新・削除時のIf-Matchに使う行版",
            "pattern": "^[0-9]+$",
            "title": "Etag",
            "type": "string"
          },
          "id": {
            "description": "不変の行識別子",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "menu_id": {
            "description": "献立",
            "format": "uuid",
            "title": "Menu Id",
            "type": "string"
          },
          "position": {
            "description": "表示順",
            "exclusiveMinimum": 0.0,
            "title": "Position",
            "type": "integer"
          },
          "recipe_version_id": {
            "description": "固定レシピ版",
            "format": "uuid",
            "title": "Recipe Version Id",
            "type": "string"
          },
          "role_option_id": {
            "description": "主菜等",
            "format": "uuid",
            "title": "Role Option Id",
            "type": "string"
          },
          "servings": {
            "description": "その料理を作る人数",
            "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,21}0*$)\\d{0,14}\\.\\d{0,6}0*$)",
            "title": "Servings",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "menu_id",
          "recipe_version_id",
          "servings",
          "role_option_id",
          "position",
          "etag"
        ],
        "title": "MenuItemRow",
        "type": "object"
      },
      "MenuItemWrite": {
        "additionalProperties": false,
        "description": "献立の料理の編集可能列。未指定NULL列はNULLにする。",
        "properties": {
          "menu_id": {
            "description": "献立",
            "format": "uuid",
            "title": "Menu Id",
            "type": "string"
          },
          "position": {
            "description": "表示順",
            "exclusiveMinimum": 0.0,
            "title": "Position",
            "type": "integer"
          },
          "recipe_version_id": {
            "description": "固定レシピ版",
            "format": "uuid",
            "title": "Recipe Version Id",
            "type": "string"
          },
          "role_option_id": {
            "description": "主菜等",
            "format": "uuid",
            "title": "Role Option Id",
            "type": "string"
          },
          "servings": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,21}0*$)\\d{0,14}\\.\\d{0,6}0*$)",
                "type": "string"
              }
            ],
            "description": "その料理を作る人数",
            "title": "Servings"
          }
        },
        "required": [
          "menu_id",
          "recipe_version_id",
          "servings",
          "role_option_id",
          "position"
        ],
        "title": "MenuItemWrite",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "食品・料理・工程・利用者操作を正規化したPostgreSQLから提供するAPI。",
    "title": "RecipeWeave API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/entities/menu_item/{row_id}": {
      "put": {
        "description": "献立の料理の更新。認証情報は依存から取得し、本人所有または管理者権限を検査する。",
        "operationId": "entity_menu_item_update",
        "parameters": [
          {
            "in": "path",
            "name": "row_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Row Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuItemWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItemRow"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "認証が必要"
          },
          "403": {
            "description": "操作・参照権限なし"
          },
          "409": {
            "description": "同時更新またはDB業務制約違反"
          },
          "422": {
            "description": "入力不正"
          },
          "428": {
            "description": "If-Matchが必要"
          },
          "503": {
            "description": "DB接続不可"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "献立の料理の更新",
        "tags": [
          "正規化データ: 献立の料理"
        ]
      }
    }
  }
}
