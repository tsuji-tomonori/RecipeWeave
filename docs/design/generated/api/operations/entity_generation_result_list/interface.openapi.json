{
  "components": {
    "schemas": {
      "GenerationInput": {
        "additionalProperties": false,
        "properties": {
          "catalog_release_id": {
            "format": "uuid",
            "title": "Catalog Release Id",
            "type": "string"
          },
          "form_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 1024,
            "title": "Form Ids",
            "type": "array"
          },
          "option_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 1024,
            "title": "Option Ids",
            "type": "array"
          },
          "policy_version": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Policy Version",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "option_ids",
          "form_ids",
          "catalog_release_id",
          "policy_version"
        ],
        "title": "GenerationInput",
        "type": "object"
      },
      "GenerationResultRow": {
        "additionalProperties": false,
        "description": "生成結果の出自のDB応答。",
        "properties": {
          "created_at": {
            "description": "作成日時(UTC)",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "etag": {
            "description": "更新・削除時のIf-Matchに使う行版",
            "pattern": "^[0-9]+$",
            "title": "Etag",
            "type": "string"
          },
          "id": {
            "description": "不変の行識別子",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "input_snapshot": {
            "$ref": "#/components/schemas/GenerationInput",
            "description": "確定入力をschema_versionで検証"
          },
          "job_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "短期ジョブ参照",
            "title": "Job Id"
          },
          "policy_id": {
            "description": "恒久方針参照",
            "format": "uuid",
            "title": "Policy Id",
            "type": "string"
          },
          "raw_output_hash": {
            "description": "原出力ハッシュ",
            "maxLength": 64,
            "minLength": 64,
            "title": "Raw Output Hash",
            "type": "string"
          },
          "raw_output_uri": {
            "anyOf": [
              {
                "maxLength": 20000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "原出力保存先",
            "title": "Raw Output Uri"
          },
          "recipe_version_id": {
            "description": "生成した版",
            "format": "uuid",
            "title": "Recipe Version Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "recipe_version_id",
          "job_id",
          "policy_id",
          "input_snapshot",
          "raw_output_uri",
          "raw_output_hash",
          "etag"
        ],
        "title": "GenerationResultRow",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "食品・料理・工程・利用者操作を正規化したPostgreSQLから提供するAPI。",
    "title": "RecipeWeave API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/entities/generation_result": {
      "get": {
        "description": "生成結果の出自の一覧。認証情報は依存から取得し、本人所有または管理者権限を検査する。",
        "operationId": "entity_generation_result_list",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GenerationResultRow"
                  },
                  "title": "Response Entity Generation Result List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "認証が必要"
          },
          "403": {
            "description": "操作・参照権限なし"
          },
          "409": {
            "description": "同時更新またはDB業務制約違反"
          },
          "422": {
            "description": "入力不正"
          },
          "503": {
            "description": "DB接続不可"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "生成結果の出自の一覧",
        "tags": [
          "正規化データ: 生成結果の出自"
        ]
      }
    }
  }
}
